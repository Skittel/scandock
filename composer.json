{
    "name": "skittel/scandock",
    "description": "ScanDock – multi-tenant scan-to-cloud gateway for copiers (FTP/FTPS upload, Microsoft Entra sign-in)",
    "license": "LicenseRef-ScanDock-MIT-Attribution",
    "type": "project",
    "homepage": "https://github.com/Skittel/scandock",
    "support": {
        "source": "https://github.com/Skittel/scandock",
        "issues": "https://github.com/Skittel/scandock/issues"
    },
    "require": {
        "php": "^8.4",
        "codeigniter4/framework": "^4.7",
        "firebase/php-jwt": "^7.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
