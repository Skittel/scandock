#!/bin/bash
# ScanDock: starts the import as soon as an FTP upload is complete.
# ProFTPD writes ".in.<name>." and renames it when done (HiddenStores), so a
# MOVED_TO event of a non-hidden file means the upload is finished.
set -u
INCOMING=/srv/scandock/incoming
SPARK=/var/www/scandock/spark

inotifywait -m -r -q -e moved_to -e close_write --format '%f' "$INCOMING" | while read -r name; do
    case "$name" in
        .*) continue ;;   # hidden: transfer still running
    esac
    # Coalesce bursts (e.g. several pages/files in a row).
    while read -r -t 1 _; do :; done
    /usr/bin/php "$SPARK" scans:ingest >/dev/null 2>&1 || true
done
